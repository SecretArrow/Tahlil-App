<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon background — emerald → teal linear gradient.

    The gradient runs diagonally from the top-left corner (deep emerald
    #065F46) to the bottom-right corner (teal #0D9488), matching the web
    app's brand palette. A subtle mid-point emerald-500 (#10B981) keeps
    the transition smooth.

    Used together with ic_launcher_foreground.xml to form the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item
                    android:offset="0.0"
                    android:color="#FF065F46" />
                <item
                    android:offset="0.5"
                    android:color="#FF10B981" />
                <item
                    android:offset="1.0"
                    android:color="#FF0D9488" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft radial glow behind the motif (matches web/public/icon.svg) -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="45"
                android:gradientRadius="62"
                android:startColor="#29FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
