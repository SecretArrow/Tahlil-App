<?xml version="1.0" encoding="utf-8"?>
<!--
    NEW Launcher icon foreground — "Rub el Hizb with Crescent & Star"

    An 8-pointed Islamic star (Rub el Hizb, formed by two overlapping
    squares) outlined in gold, containing:
      * A cream crescent moon opening upward
      * A small gold 5-point star cradled in the crescent

    Drawn on the 108x108 adaptive-icon canvas; all content stays inside the
    66dp safe-zone circle centered at (54, 54):
      - top-most point   (8-point star top)  y = 22  -> dist 32 from center
      - bottom-most      (8-point star bot)   y = 78  -> dist 24 from center
      - left/right       (8-point star edge) x = 34/74 -> dist 20 from center

    Color palette (matches web/public/icon.svg):
      - Star outline:    gold #FCD34D (outer) + #B45309 (inner shadow)
      - Crescent:        cream #FEF3C7
      - Inner star:      gold #F59E0B
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── 8-pointed Islamic star (Rub el Hizb) — gold outline ────────
         Two overlapping squares (one axis-aligned, one rotated 45°) centered
         at (54, 50). Together they form the 8-point star outline.
         Fill is transparent so the background shows through. -->
    <path
        android:strokeColor="#FFFCD34D"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round"
        android:fillType="evenOdd"
        android:pathData="M34,30 L74,30 L74,70 L34,70 Z M54,22 L74,50 L54,78 L34,50 Z" />

    <!-- Inner gold stroke for depth (slightly darker, thinner) -->
    <path
        android:strokeColor="#FFB45309"
        android:strokeWidth="0.8"
        android:strokeLineJoin="round"
        android:fillType="evenOdd"
        android:pathData="M35.5,31.5 L72.5,31.5 L72.5,68.5 L35.5,68.5 Z M54,24 L72.5,50 L54,76 L35.5,50 Z" />

    <!-- ── Crescent moon (cream), opens upward ────────────────────────
         Outer circle c=(54,48) r=11; cut circle c=(54,45) r=9.5. -->
    <path
        android:fillColor="#FFFEF3C7"
        android:fillType="evenOdd"
        android:pathData="M54,37 a11,11 0 1,0 0,22 a11,11 0 1,0 0,-22 Z M54,35.5 a9.5,9.5 0 1,0 0,19 a9.5,9.5 0 1,0 0,-19 Z" />

    <!-- ── Gold 5-point star cradled in the crescent ──────────────────
         Center (54,46), outer R=3.6, inner r=1.5. -->
    <path
        android:fillColor="#FFF59E0B"
        android:pathData="M54,42.4 L54.88,44.86 L57.49,44.99 L55.46,46.65 L56.14,49.18 L54,47.7 L51.86,49.18 L52.54,46.65 L50.51,44.99 L53.12,44.86 Z" />

</vector>
