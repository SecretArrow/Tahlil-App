<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (Android 12+) — for device-to-device migration
    and for cloud backups. We include all shared preferences so the user's
    display & typography settings are restored on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/." />
    </device-transfer>
</data-extraction-rules>
